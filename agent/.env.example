# ── chain ──
ARC_RPC_URL=https://rpc.mainnet.arc.io
CHAIN_ID=5042
FACTORY=0xb3F362850E04aD6e9147698Cc1EdbcB8891f307e
USDC=0x3600000000000000000000000000000000000000
# venues this agent knows how to operate (ERC-4626 USDC vaults), address:name
# Galaxy runs the first mandate; 0xbeef0016 (Steakhouse Prime, no Circle warnings) is the default for new ones
KNOWN_VENUES=0x8E357432CC12ff425c36432F312968aEb16112AF:Galaxy USDC (Morpho),0xbeef0016cb2Fd5C352ea7CA08a9f54739DFa7298:Steakhouse Prime USDC (Morpho),0xbeef0007d5A04246F5382957035Df34f7e82102e:Steakhouse Prime USDC 0xbeef0007 (Morpho)
EXPLORER_URL=https://explorer.arc.io

# ── Circle Earn Kit: Circle's liquidity, APY and risk warnings per vault (on by default on Arc) ──
# CIRCLE_EARN_KIT=off
# CIRCLE_API_KEY=            # optional; without one requests share a public rate limit
# CIRCLE_BLOCK_WARNINGS=low_liquidity,not_whitelisted   # warnings that stop new deposits
INDEX_FROM_BLOCK=23603500

# ── signer ──
# local (default): reuse the Foundry keystore, password in a chmod-600 file
AGENT_SIGNER=local
KEYSTORE=~/.foundry/keystores/mandate-agent
KEYSTORE_PASSWORD_FILE=~/.mandate-agent.pass
# AGENT_PRIVATE_KEY=   # fallback only, never commit

# Circle Agent Wallet: replaces the local key. First run `circle wallet login` and
# use the Arc address returned by `circle wallet list --chain ARC --type agent`.
# AGENT_SIGNER=circle
# CIRCLE_WALLET_ADDRESS=0x...
# CIRCLE_CHAIN=ARC
# CIRCLE_CLI=circle

# ── reviewer LLM (OpenAI-compatible; LiteLLM router). Empty = policy only ──
LLM_BASE_URL=http://127.0.0.1:4000
LLM_MODEL=agent-loop
LLM_API_KEY=
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_MS=60000

# ── public API (decision records are linked from on-chain notes) ──
PORT=8096
HOST=127.0.0.1
PUBLIC_BASE_URL=https://mandate.baserep.xyz
DATA_DIR=./data
PAYABLES_FILE=./payables.json

# ── cadence ──
CYCLE_SECONDS=300
# poke (~0.0023 USDC) and heartbeat notes (~0.0008 USDC) cost gas; at small balances they exceed the yield
POKE_MINUTES=1440
HEARTBEAT_HOURS=24
RISK_COOLDOWN_HOURS=24
BLOCKED_BACKOFF_MINUTES=60

# ── policy (USDC amounts in whole units) ──
RESERVE_FLOOR_USDC=0.5
RESERVE_BPS=1000
HORIZON_HOURS=72
URGENT_HOURS=24
PAYABLE_BUFFER_BPS=1000
MIN_MOVE_USDC=0.25
BAND_BPS=500
LOSS_TRIP_BPS=5
WIND_DOWN_HOURS=24

DRY_RUN=false

# ── optional Aomi × Circle execution (Arc Testnet only) ──
# When AOMI_TASK_ENDPOINT is set, the existing Mandate policy keeps deciding,
# while Aomi simulates its exact ordered MandateAccount.execute calls and the
# Circle Agent Wallet separately signs Task auth, payment, and execution.
# AOMI_TASK_ENDPOINT=https://chat.aomi.dev/v1/task/build
# CIRCLE_WALLET_ADDRESS=0x...
# AOMI_TASK_SELLER=0x...
# AOMI_TRUSTED_JWKS_FILE=./trusted-aomi-jwks.json
# AOMI_MAX_FEE_MICROUSDC=1100000
# AOMI_MAX_GAS_UNITS=1000000
# AOMI_STATE_DIR=./data/aomi
